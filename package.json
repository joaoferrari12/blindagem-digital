{
  "name": "blindagem-digital",
  "private": true,
  "version": "1.0.0",
  "description": "A 10-minute digital security check-up for everyday people. Static, no backend, Portuguese and English.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "a11y": "node scripts/a11y.mjs",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource/atkinson-hyperlegible": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
